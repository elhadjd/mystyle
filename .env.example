# SISGESC Site API — server only (do not prefix with NEXT_PUBLIC_)
# The key is never sent to the browser. Next.js server actions add it.

# Base origin only, no trailing slash. Example: https://app.example.com
SITE_API_HOST=

# Site API key from SISGESC / company admin (site_api_keys), not an ERP user token
SITE_API_KEY=

# Optional appointment deposit (USD/EUR as configured in ERP). If set (>= 0.01),
# booking submit includes amount + success/cancel URLs for Stripe Checkout.
# SITE_APPOINTMENT_DEPOSIT_AMOUNT=15
